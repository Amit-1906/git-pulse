# ==============================================================================
# GitPulse Environment Configuration
# Copy this file to .env and customize values for your deployment
# ==============================================================================

# Application Environment (development | production | testing)
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="GitPulse"
API_V1_STR="/api/v1"

# FastAPI Backend Server Bind
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL Data Warehouse
# Option A (Cloud / Vercel): Full pooled or direct PostgreSQL connection string
DATABASE_URL="postgresql://gitpulse:gitpulse_secret@localhost:5432/gitpulse_db"
# Option B (Discrete Host/Port/User credentials):
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gitpulse
POSTGRES_PASSWORD=gitpulse_secret
POSTGRES_DB=gitpulse_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
DB_ECHO=false

# GitHub REST API Authentication
# Supplying a Personal Access Token (PAT) raises the rate limit from 60 to 5,000 req/hr
# Supports both GITHUB_TOKEN and GITHUB_ACCESS_TOKEN
GITHUB_TOKEN=
GITHUB_ACCESS_TOKEN=
GITHUB_API_BASE_URL="https://api.github.com"
GITHUB_API_TIMEOUT=30

# Streamlit Frontend → Backend Connection
# Local development: set to http://localhost:8000/api/v1
# Streamlit Community Cloud: set to https://your-vercel-deployment.vercel.app/api/v1
# Note: On Vercel, BACKEND_URL is injected automatically via the service binding — do not set it manually there.
API_BASE_URL="http://localhost:8000/api/v1"

# Logging & Monitoring
LOG_LEVEL=INFO
LOG_FORMAT=text

# Security
SECRET_KEY="replace-this-in-production-with-a-random-cryptographic-key"

