{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "gitpulse/backend",
      "framework": "fastapi",
      "buildCommand": "pip install -r requirements.txt",
      "runtime": "python3.10"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "backend"
      }
    }
  ]
}
